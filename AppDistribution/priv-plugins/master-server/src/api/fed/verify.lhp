<?lua
local actionId = _GET["action"]
if not actionId or actionId:match("^%s*$") then
    http_response_code(400)
    die("Missing action id")
end

header("Content-Type: application/json")
http_response_code(200)

local out = _G.MASTERSERVER_FEDERATION.LookupOutbound(actionId)
if not out then
    die(json.stringify({ Ok = false }))
end

die(json.stringify({
    Ok       = true,
    Actor    = _G.MASTERSERVER_FULL_IDENTITY(out.FromUsername),
    Target   = out.ToIdentity,
    BodyHash = out.BodyHash,
    Type     = "message",
}))
