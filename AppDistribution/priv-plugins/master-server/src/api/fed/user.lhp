<?lua
local username = _PARAMS["username"]
if not username or username:match("^%s*$") then
    http_response_code(400)
    die("Missing username")
end

local profile, err = _G.MASTERSERVER_FEDERATION.LocalUserProfile(username)
if not profile then
    http_response_code(404)
    die(tostring(err or "User not found"))
end

header("Content-Type: application/json")
http_response_code(200)
die(json.stringify(profile))
