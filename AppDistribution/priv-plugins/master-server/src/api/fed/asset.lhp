<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Master Server
-- File: api/fed/asset.lhp
-- Description: Public federation endpoint - serves this master's asset binary by id, so a game server can
--              pull a federated player's worn items (and their deps) on demand while they're in-game. The
--              engine requests each asset by id as it needs it, so no dependency graph is required here.
--              GET ?id=<assetId>
-- Started by: Hattozo
-- Started on: 7/3/2026
-- ////////////////////////////////////////////////////////////////////////////////
local id = tonumber(_GET["id"])
if id == nil then
    http_response_code(400)
    die("Missing id")
end

local res, data, hash = core.GetEmuDbManager():RetrieveAssetData(id, 0) -- version 0 = latest
if data == nil or #data == 0 then
    http_response_code(404)
    die("Asset not found")
end

header("Content-Type: application/octet-stream")
header("Cache-Control: max-age=300")
http_response_code(200)
die(data)
?>
