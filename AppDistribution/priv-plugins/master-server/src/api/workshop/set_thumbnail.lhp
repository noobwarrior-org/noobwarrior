<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local user = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if user == nil then
    http_response_code(401)
    die("You must be logged in to manage workshop submissions")
end

if _G.MASTERSERVER_DB == nil then
    http_response_code(500)
    die("No master server database available")
end

local id = tonumber(_GET["id"])
if not id then
    http_response_code(400)
    die("Missing or invalid submission id")
end

local mime = type(_GET["mime"]) == "string" and _GET["mime"]:lower() or ""
if not _G.MASTERSERVER_WORKSHOP_THUMBNAIL_MIMES[mime] then
    http_response_code(400)
    die("Thumbnail must be a PNG, JPEG, GIF or WebP image")
end

local data = _RAW_POST or ""
if #data == 0 then
    http_response_code(400)
    die("No image data was uploaded")
end
if #data > _G.MASTERSERVER_WORKSHOP_MAX_THUMBNAIL_BYTES() then
    http_response_code(413)
    die(string.format("Thumbnail is too large (max %d bytes)", _G.MASTERSERVER_WORKSHOP_MAX_THUMBNAIL_BYTES()))
end

-- Only the uploader may set their own submission's thumbnail.
local rows = _G.MASTERSERVER_DB:QueryTyped(
    "SELECT UploaderId, ThumbnailHash FROM WorkshopSubmission WHERE Id = ?;", id)
if rows == nil or rows[1] == nil then
    http_response_code(404)
    die("Submission not found")
end
if rows[1].UploaderId ~= user.Id then
    http_response_code(403)
    die("This submission does not belong to you")
end
local oldThumb = rows[1].ThumbnailHash

local vfs = url.GetVfs(_G.MASTERSERVER_PLUGINDATA .. "/")
if vfs == nil then
    http_response_code(500)
    die("Submission storage is unavailable")
end

local digest = hash.Sha256(data)
if not vfs:WriteFile("/master/thumbnails/" .. digest, data) then
    http_response_code(500)
    die("Failed to write thumbnail to storage")
end

local updated = _G.MASTERSERVER_DB:QueryTyped(
    "UPDATE WorkshopSubmission SET ThumbnailHash = ?, ThumbnailMime = ? WHERE Id = ?;",
    digest, mime, id)
if updated == false then
    http_response_code(500)
    die("Failed to record thumbnail")
end

-- If we replaced an older thumbnail that nothing else points at, clean it up.
if oldThumb ~= nil and not _G.MASTERSERVER_BLANK(oldThumb) and oldThumb ~= digest then
    local stillUsed = _G.MASTERSERVER_DB:QueryTyped(
        "SELECT 1 FROM WorkshopSubmission WHERE ThumbnailHash = ? LIMIT 1;", oldThumb)
    if stillUsed == nil or stillUsed[1] == nil then
        local oldPath = "/master/thumbnails/" .. oldThumb
        if vfs:EntryExists(oldPath) then
            vfs:DeleteEntry(oldPath)
        end
    end
end

header("Content-Type: application/json")
http_response_code(200)
die(json.stringify({
    SubmissionId = id,
    ThumbnailHash = digest,
}))
?>
