<?lua
local idParam = tonumber(_GET["id"])
if not idParam then
    http_response_code(400)
    die("Missing or invalid submission id")
end

if _G.MASTERSERVER_DB == nil then
    http_response_code(500)
    die("No master server database available")
end

local rows = _G.MASTERSERVER_DB:QueryTyped(
    "SELECT ThumbnailHash, ThumbnailMime FROM WorkshopSubmission WHERE Id = ?;", idParam)
if rows == nil or rows[1] == nil then
    http_response_code(404)
    die("Submission not found")
end

local row = rows[1]
if _G.MASTERSERVER_BLANK(row.ThumbnailHash) then
    http_response_code(404)
    die("This submission has no thumbnail")
end

local vfs = url.GetVfs(_G.MASTERSERVER_PLUGINDATA .. "/")
if vfs == nil then
    http_response_code(500)
    die("Submission storage is unavailable")
end

local path = "/master/thumbnails/" .. row.ThumbnailHash
if not vfs:EntryExists(path) then
    http_response_code(404)
    die("Thumbnail file is missing")
end

local handle = vfs:OpenHandle(path)
if handle == 0 then
    http_response_code(500)
    die("Failed to open thumbnail file")
end

local parts = {}
local isReading, chunk = true, nil
repeat
    isReading, chunk = vfs:ReadHandleChunk(handle, 65536)
    if chunk and chunk ~= "" then
        parts[#parts + 1] = chunk
    end
until not isReading
vfs:CloseHandle(handle)

local mime = row.ThumbnailMime
if not _G.MASTERSERVER_WORKSHOP_THUMBNAIL_MIMES[mime] then
    mime = "application/octet-stream"
end

header("Content-Type: " .. mime)
header("Cache-Control: public, max-age=3600")
http_response_code(200)
die(table.concat(parts))
?>
