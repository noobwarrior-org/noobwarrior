<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local user = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if user == nil then
    http_response_code(401)
    die("You must be logged in to upload to the workshop")
end

local uploadToken = _GET["token"]
if not uploadToken or uploadToken:match("^%s*$") then
    http_response_code(400)
    die("Missing upload token")
end

_G.MASTERSERVER_SWEEP_WORKSHOP_UPLOADS()

local up = _G.WORKSHOP_UPLOADS[uploadToken]
if up == nil then
    http_response_code(404)
    die("Unknown or expired upload token")
end
if up.UploaderId ~= user.Id then
    http_response_code(403)
    die("This upload does not belong to you")
end

local chunk = _RAW_POST or ""
if #chunk == 0 then
    http_response_code(400)
    die("Empty chunk")
end

local maxBytes = _G.MASTERSERVER_WORKSHOP_MAX_UPLOAD_BYTES()
local newTotal = up.ReceivedBytes + #chunk
if newTotal > maxBytes then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(413)
    die(string.format("Upload exceeded maximum size of %d bytes", maxBytes))
end
if up.ExpectedBytes > 0 and newTotal > up.ExpectedBytes then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(400)
    die("Received more data than declared in start-upload")
end

up.Chunks[#up.Chunks + 1] = chunk
up.ReceivedBytes = newTotal
up.LastActivity = os.time()

header("Content-Type: application/json")
http_response_code(200)
die(json.stringify({
    ReceivedBytes = up.ReceivedBytes,
    ExpectedBytes = up.ExpectedBytes,
}))
