<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local user = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if user == nil then
    http_response_code(401)
    die("You must be logged in to upload to the workshop")
end

local uploadToken
local ok, body = pcall(json.parse, _RAW_POST)
if ok and type(body) == "table" then
    uploadToken = body.UploadToken
end
if not uploadToken or uploadToken:match("^%s*$") then
    http_response_code(400)
    die("Missing upload id")
end

_G.MASTERSERVER_SWEEP_WORKSHOP_UPLOADS()

local up = _G.WORKSHOP_UPLOADS[uploadToken]
if up == nil then
    http_response_code(404)
    die("Unknown or expired upload id")
end
if up.UploaderId ~= user.Id then
    http_response_code(403)
    die("This upload does not belong to you")
end

if up.ReceivedBytes == 0 then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(400)
    die("No data was uploaded")
end
if up.ExpectedBytes > 0 and up.ReceivedBytes ~= up.ExpectedBytes then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(400)
    die(string.format("Incomplete upload: expected %d bytes but received %d", up.ExpectedBytes, up.ReceivedBytes))
end

if _G.MASTERSERVER_DB == nil then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("No master server database available")
end

local vfs = url.GetVfs(_G.MASTERSERVER_PLUGINDATA .. "/")
if vfs == nil then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("Submission storage is unavailable")
end

local data = table.concat(up.Chunks)
up.Chunks = nil  -- release the per-chunk references once we have the whole blob

local digest = hash.Sha256(data)
if not vfs:WriteFile("/master/submissions/" .. digest .. ".nwdb", data) then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("Failed to write submission to storage")
end

local insertSuccess = _G.MASTERSERVER_DB:QueryTyped(
    "INSERT INTO WorkshopSubmission (UploaderId, Name, Description, Type, Filename, SizeBytes, Hash) " ..
    "VALUES (?, ?, ?, ?, ?, ?, ?);",
    up.UploaderId, up.Name, up.Description, up.Type, up.Filename, up.ReceivedBytes, digest
)
if insertSuccess == false then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("Failed to insert workshop submission into database")
end

local idRows = _G.MASTERSERVER_DB:Query("SELECT last_insert_rowid() AS Id;")
local submissionId = idRows and idRows[1] and idRows[1].Id or nil
if not submissionId then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("Failed to retrieve workshop submission ID")
end

--[[ this stores the workshop submission id as the file name instead of the sha256 hash like from earlier.
    i commented it out because well, preventing data redundancy is nice
if not vfs:WriteFile("/master/submissions/" .. submissionId .. ".nwdb", data) then
    _G.WORKSHOP_UPLOADS[uploadToken] = nil
    http_response_code(500)
    die("Failed to write submission to storage")
end
]]

_G.WORKSHOP_UPLOADS[uploadToken] = nil

header("Content-Type: application/json")
http_response_code(200)
die(json.stringify({
    SubmissionId = submissionId,
    Name         = up.Name,
    Type         = up.Type,
    SizeBytes    = up.ReceivedBytes,
    Hash         = digest,
}))