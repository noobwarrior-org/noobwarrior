<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local user = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if user == nil then
    http_response_code(401)
    die("You must be logged in to comment")
end

if _G.MASTERSERVER_DB == nil then
    http_response_code(500)
    die("No master server database available")
end

local submissionId = tonumber(_POST["submissionId"])
if not submissionId then
    http_response_code(400)
    die("Missing or invalid submission id")
end

local body = _POST["body"]
if not body or body:match("^%s*$") then
    http_response_code(400)
    die("Comment cannot be empty")
end
if #body > 2000 then
    http_response_code(400)
    die("Comment cannot be longer than 2000 characters")
end

-- Make sure the submission actually exists before attaching a comment to it
local exists = _G.MASTERSERVER_DB:QueryTyped("SELECT 1 FROM WorkshopSubmission WHERE Id = ?;", submissionId)
if exists == nil or exists[1] == nil then
    http_response_code(404)
    die("Submission not found")
end

local inserted = _G.MASTERSERVER_DB:QueryTyped(
    "INSERT INTO WorkshopComment (SubmissionId, AuthorId, Body) VALUES (?, ?, ?);",
    submissionId, user.Id, body)
if inserted == false then
    http_response_code(500)
    die("Failed to post comment")
end

header("Location: /workshop?type=details&id=" .. tostring(submissionId) .. "#comments")
http_response_code(302)
die("")
?>
