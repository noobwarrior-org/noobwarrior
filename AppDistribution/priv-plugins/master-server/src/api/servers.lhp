<?lua
_G.MASTERSERVER_SWEEP_EMU_SERVERS()

local list = {}
for _, node in pairs(_G.EMU_SERVERS) do
    for _, s in pairs(node.Servers or {}) do
        list[#list + 1] = {
            EmulatorIp   = node.Ip,
            EmulatorPort = node.Port,
            EmulatorName = node.Name,
            ServerId   = s.Pid,
            PlaceId    = s.PlaceId,
            GamePort   = s.Port,
            Version    = s.Version or node.Version,
            Players    = 0,   -- player counts are not reported by the emulator yet
            MaxPlayers = 0,
            FirstSeen  = s.FirstSeen,
            LastSeen   = s.LastSeen,
        }
    end
end

header("Content-Type: application/json")
http_response_code(200)

if #list == 0 then
    die("[]")
end
die(json.stringify(list))
