<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local ok, body = pcall(json.parse, _RAW_POST)
if not ok or type(body) ~= "table" then
    http_response_code(400)
    die("Malformed JSON")
end

local event = body.Event or ""

-- Who is announcing? The emulator sends the session of the account it is signed in to here.
-- With master.auth.require_for_hosting on (the default), an anonymous announce is refused, so the
-- server list only ever contains servers someone on this master stands behind.
local host = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if host == nil and reg.GetKeyValue("master.auth.require_for_hosting") ~= false then
    http_response_code(401)
    die("This master server only lists servers hosted by its own accounts. Sign in to it in the Online window, or ask the operator to turn off master.auth.require_for_hosting.")
end

local hostIdentity = host and _G.MASTERSERVER_FULL_IDENTITY(host.Name) or ""

local ip = _SERVER.REMOTE_ADDR or ""

local port = tonumber(body.Port)
if not port or port <= 0 or port > 65535 then
    http_response_code(400)
    die("Missing or invalid Port")
end

local key = ip .. ":" .. tostring(port)

_G.MASTERSERVER_SWEEP_EMU_SERVERS()

if event == "Goodbye" then
    _G.EMU_SERVERS[key] = nil
    http_response_code(200)
    die("")
end

if event ~= "Hello" and event ~= "Heartbeat" then
    http_response_code(400)
    die("Unknown Event")
end

local now = os.time()
local existing = _G.EMU_SERVERS[key]
local prevServers = existing and existing.Servers or {}

local servers = {}
local incoming = type(body.Servers) == "table" and body.Servers or nil
if incoming then
    for _, s in ipairs(incoming) do
        local pid = tonumber(s.Pid)
        if pid then
            local prev = prevServers[pid]
            servers[pid] = {
                Pid       = pid,
                PlaceId   = tonumber(s.PlaceId),
                Port      = tonumber(s.Port),
                Version   = tostring(s.Version or body.Version or ""),
                FirstSeen = prev and prev.FirstSeen or now,
                LastSeen  = now,
            }
        end
    end
else
    local placeId = tonumber(body.PlaceId)
    if placeId then
        local prev = prevServers[0]
        servers[0] = {
            Pid       = 0,
            PlaceId   = placeId,
            Port      = nil,
            Version   = tostring(body.Version or ""),
            FirstSeen = prev and prev.FirstSeen or now,
            LastSeen  = now,
        }
    end
end

_G.EMU_SERVERS[key] = {
    Ip           = ip,
    Port         = port,
    Name         = tostring(body.Name or ""),
    Version      = tostring(body.Version or ""),
    HostIdentity = hostIdentity,
    HostName     = host and tostring(host.Name) or "",
    HostUserId   = host and host.Id or nil,
    FirstSeen    = existing and existing.FirstSeen or now,
    LastSeen     = now,
    Servers      = servers,
}

http_response_code(200)
die("")
