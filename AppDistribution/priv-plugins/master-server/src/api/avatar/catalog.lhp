<?lua
header("Content-Type: application/json")

local assetType = tonumber(_GET["type"]) or 0
local search = _GET["search"] or ""
local page = tonumber(_GET["page"]) or 0
local pageSize = 60

local mgr = core.GetEmuDbManager()
if mgr == nil then
    die(json.stringify({ items = {}, page = 0, pageCount = 1, total = 0 }))
end

local items = {}
local seen = {}
for _, db in ipairs(mgr:GetMountedDatabases()) do
    local rows
    if search ~= "" then
        local esc = search:gsub("([%%_\\])", "\\%1") -- escape LIKE wildcards
        rows = db:QueryTyped("SELECT Id, Name FROM Asset WHERE Type = ? AND Name LIKE ? ESCAPE '\\';",
            assetType, "%" .. esc .. "%")
    else
        rows = db:QueryTyped("SELECT Id, Name FROM Asset WHERE Type = ?;", assetType)
    end
    if type(rows) == "table" then
        for _, r in ipairs(rows) do
            if not seen[r.Id] then
                seen[r.Id] = true
                items[#items + 1] = { id = r.Id, name = r.Name, assetTypeId = assetType }
            end
        end
    end
end

table.sort(items, function(a, b) return tostring(a.name) < tostring(b.name) end)

local total = #items
local pageCount = math.max(1, math.ceil(total / pageSize))
if page >= pageCount then page = pageCount - 1 end
if page < 0 then page = 0 end

local pageItems = {}
for i = page * pageSize + 1, math.min(total, (page + 1) * pageSize) do
    pageItems[#pageItems + 1] = items[i]
end

die(json.stringify({ items = pageItems, page = page, pageCount = pageCount, total = total }))
?>
