<?lua
header("Content-Type: application/json")

local assetType = tonumber(_GET["type"]) or 0
local search = _GET["search"] or ""
local page = tonumber(_GET["page"]) or 0
local pageSize = 60

local fed = _G.MASTERSERVER_FEDERATION
local selfDomain = _G.MASTERSERVER_DOMAIN()

-- Merge this master's own items with every federated peer's, each tagged with the master + db it lives in.
-- Dedup by origin#id: the same id from two different masters are DIFFERENT items (separate origins).
local items = {}
local seen = {}
local function add(id, name, dbName, origin)
    if id == nil then return end
    local key = tostring(origin):lower() .. "#" .. tostring(id)
    if seen[key] then return end
    seen[key] = true
    items[#items + 1] = { id = id, name = name, assetTypeId = assetType, db = dbName, originDomain = origin }
end

for _, it in ipairs(fed.LocalCatalog(assetType, search)) do
    add(it.id, it.name, it.db, selfDomain)
end
for _, it in ipairs(fed.PeerCatalog(assetType, search)) do
    add(it.id, it.name, it.db, it.originDomain)
end

table.sort(items, function(a, b) return tostring(a.name) < tostring(b.name) end)

local total = #items
local pageCount = math.max(1, math.ceil(total / pageSize))
if page >= pageCount then page = pageCount - 1 end
if page < 0 then page = 0 end

local pageItems = {}
for i = page * pageSize + 1, math.min(total, (page + 1) * pageSize) do
    pageItems[#pageItems + 1] = items[i]
end

die(json.stringify({ items = pageItems, page = page, pageCount = pageCount, total = total, selfDomain = selfDomain }))
?>
