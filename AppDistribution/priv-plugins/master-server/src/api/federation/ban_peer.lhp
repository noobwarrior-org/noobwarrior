<?lua
if _SERVER.REQUEST_METHOD ~= "POST" then
    http_response_code(405)
    die("Request method needs to be POST")
end

local user = _G.MASTERSERVER_RESOLVE_SESSION_USER(_COOKIE[".LOGINSESSION"])
if user == nil then
    http_response_code(401)
    die("You must be logged in to manage federation")
end

local domain = _POST["domain"]
if not domain or domain:match("^%s*$") then
    http_response_code(400)
    die("Domain is required")
end

_G.MASTERSERVER_FEDERATION.BanPeer(domain)

header("Location: /control-panel?category=federation")
http_response_code(302)
die("")
?>
