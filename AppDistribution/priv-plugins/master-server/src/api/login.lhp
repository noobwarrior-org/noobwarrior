<?lua
local username = _POST["username"]
local password = _POST["password"]

if username == nil or username:match("^%s*$") or password == nil or password:match("^%s*$") then
    http_response_code(401)
    die("Cannot contain blank username or password")
end

local masterDb = core.GetMasterDatabase()
local sqlRows = masterDb:QueryTyped("SELECT Id, PasswordHash FROM User WHERE Name = ? COLLATE NOCASE;", username)
if not sqlRows or not sqlRows[1] then
    http_response_code(401)
    die("Invalid username or password")
end

echo("WIP")