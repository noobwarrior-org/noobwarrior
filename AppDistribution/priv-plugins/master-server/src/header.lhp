<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Master Server
-- File: header.lhp
-- Description:
-- Started by: Hattozo
-- Started on: 6/25/2026
-- ////////////////////////////////////////////////////////////////////////////////
startRenderTime = os.clock()
local function AddNavbarButton(url, name)
   echo(string.format([[<li class="navbar-button"><a href="%s">%s</a></li>]], url, name, name))
end

_SESSION.Token = nil
_SESSION.User = nil

local token = _COOKIE[".LOGINSESSION"]
local db = token and core.GetMasterDatabase() or nil
if db ~= nil then
    local ttl = (tonumber(reg.GetKeyValue("emu.auth.session_ttl_days")) or 30) * 86400
    local rows = db:QueryTyped(
        "SELECT u.Id AS Id, u.Name AS Name, u.DisplayName AS DisplayName " ..
        "FROM LoginSession s INNER JOIN User u ON u.Id = s.UserId " ..
        "WHERE s.Token = ? AND (? <= 0 OR (unixepoch() - s.LastUsedTimestamp) < ?);",
        token, ttl, ttl
    )
    if rows ~= nil and rows[1] ~= nil then
        local row = rows[1]
        _SESSION.Token = token
        _SESSION.User = {
            Id = row.Id,
            Name = row.Name,
            DisplayName = row.DisplayName,
        }

        db:QueryTyped("UPDATE LoginSession SET LastUsedTimestamp = unixepoch() WHERE Token = ?;", token)
    end
end
?>
<!DOCTYPE html>
<html>
    <head>
        <?lua include("plugin://http-base@noobwarrior.org/src/shared.lhp") ?>
        <link rel="stylesheet" href="/css/masterserver-main.css">
        <title><?lua echo(pageTitle or "Untitled Page") ?></title>
    </head>
    <body>
        <br>
        <div class="main">
            <div class="header">
                <span style="float: left;"><img src="/img/icon1024.png" alt="noobWarrior logo" width="64" height="64">noobWarrior</span>
                <span style="float: right;"><img src="/img/icon1024.png" alt="noobWarrior logo" width="64" height="64">noobWarrior</span>
            </div>
            <ul class="navbar">
                <div class="navbar-left">
                <?lua
                    AddNavbarButton("/", "Home")
                    AddNavbarButton("/servers", "Servers")
                    AddNavbarButton("/workshop", "Workshop")
                    AddNavbarButton("/catalog", "Catalog")
                    AddNavbarButton("/forums", "Forums")
                    AddNavbarButton("/groups", "Groups")
                    AddNavbarButton("/help", "Help")
                ?>
                </div>
                <div class="navbar-right">
                <?lua
                    if _SESSION.User then
                        AddNavbarButton("/control-panel", "Control Panel")
                        AddNavbarButton("/messages", "Messages")
                        AddNavbarButton("/settings", "Settings")
                        AddNavbarButton("/@" .. (_SESSION.User.Name or ""), _SESSION.User.DisplayName or _SESSION.User.Name)
                        AddNavbarButton("/v1/logout", "Logout")
                    else
                        AddNavbarButton("/login", "Login")
                    end
                ?>
                </div>
            </ul>
            <div class="content">