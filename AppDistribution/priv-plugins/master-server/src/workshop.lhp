pageTitle = "Workshop"
include("header.lhp")
?>

<script src="/js/workshop.js"></script>

<div class="workshop-topbar">
    <div class="workshop-banner">
        <br>
        <h1>Workshop</h1>
        <p>The ultimate place to share your creations</p>
        <br>
    </div>
    <ul class="navbar">
        <div class="navbar-left">
            <li><a href="/workshop">All</a></li>
            <li><a href="/workshop?type=databases">Databases</a></li>
            <li><a href="/workshop?type=plugins">Plugins</a></li>
            <?lua
            if _SESSION.User then
                echo([[<li><a href="/workshop?type=my-submissions">My Submissions</a></li>]])
                echo([[<li><a href="/workshop?type=upload">Upload...</a></li>]])
            end
            ?>
        </div>
        <div class="navbar-right">
            <form action="/workshop" method="get">
                <input type="search" id="site-search" name="q" placeholder="Search..." value=<?lua echo(_GET["q"] and "\"" .. _GET["q"] .. "\"" or "\"\"") ?>>
                <button type="submit">Search</button>
            </form>
        </div>
    </ul>
</div>

<br>

<?lua
local type = _GET["type"]

if type == nil or type:match("^%s*$") or type == "databases" or type == "plugins" then
    echo([[<h1>Most Popular Submissions</h1>]])
    local submissionQuery = _G.MASTERSERVER_DB:Query("SELECT Id, Name, UploaderId FROM WorkshopSubmission;")
    if submissionQuery ~= nil then
        for index, row in ipairs(submissionQuery) do
            local username = "No One!"
            local userDb = core.GetEmuDbManager():GetFirstDbWhereItemExists(ItemType.User, row.UploaderId)
            if userDb then
                local userQuery = userDb:QueryTyped("SELECT Name FROM User WHERE Id = ?;", row.UploaderId)
                if userQuery ~= nil and userQuery ~= false then
                    username = userQuery[1].Name
                end
            end
            
            echo([[
            <div class="workshop-submission-card">
                <img src="https://i.pinimg.com/736x/7f/1e/06/7f1e069f7718a860470d8cfc2dcfd4ad.jpg" alt="Submission" style="width:100%">
                <a>]]) echo(row.Name) echo([[</a>
                <p style="margin: 0; padding-top: 4px; line-height: 1;">]]) echo("Submitted by "..username) echo([[</p>
            </div>
            ]])
        end
    else
        echo("<p>Wow, there really seems to be no submissions. That sucks. How about you upload some of your own?</p>")
    end
elseif type == "my-submissions" then
    echo([[<h1>My Submissions</h1>]])
    echo("<p>You really have no submissions of your own? Get motivated and start uploading!</p>")
elseif type == "upload" then
    echo([[<h1>Upload</h1>]])
    echo([==[
        <div class="container">
            <label for="ws-name"><b>Name</b></label>
            <input type="text" id="ws-name" placeholder="Enter name" required>

            <label for="ws-type"><b>Type</b></label>
            <select id="ws-type">
                <option value="database">Database (.nwdb)</option>
                <option value="plugin">Plugin</option>
            </select>

            <label for="ws-desc"><b>Description</b></label>
            <textarea id="ws-desc" placeholder="Describe your submission..."></textarea>

            <label for="ws-file"><b>File</b></label>
            <input type="file" id="ws-file" required>

            <button type="button" id="ws-upload-btn">Upload</button>
            <progress id="ws-progress" value="0" max="100" style="display:none; width:100%;"></progress>
            <p id="ws-status"></p>
        </div>
        <script>
        SetupSubmissionUploadSystem();
        </script>
    ]==])
end
?>

<?lua include("footer.lhp") ?>
