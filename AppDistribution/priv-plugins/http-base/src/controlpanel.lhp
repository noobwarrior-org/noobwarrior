<?lua
if _SESSION.User == nil then
    include("login-required.lhp")
    return
end

local button_names = {
    ["general"] = "General",
    ["items"] = "Items",
    ["databases"] = "Databases",
    ["plugins"] = "Plugins",
    ["forums"] = "Forums",
    ["avatar"] = "Avatar",
    ["banners"] = "Banners",
    ["themes"] = "Themes",
    ["email"] = "Email",
    ["taskscheduler"] = "Task Scheduler",
    ["filesystem"] = "File System",
    ["lua"] = "Lua Shell",
    ["logs"] = "Logs",
    ["reports"] = "Reports",
    ["bans"] = "Bans",
    ["emergency"] = "Emergency",
    ["about"] = "About"
}

local function SetupSidebar(categories)
    for _, category in ipairs(categories) do
        if category.Name then
            echo("<h3>"..category.Name.."</h3>")
        end
        for i, buttonName in ipairs(category.Buttons) do
            if buttonName ~= "emergency" then
                echo(string.format("<a href=\"control-panel?category=%s\" class=\"%s\">%s</a>", buttonName, _GET["category"] == buttonName and "active" or "", button_names[buttonName]))
            else
                echo(string.format("<a href=\"control-panel?category=%s\" class=\"%s\" style=\"color: red;\">%s</a>", buttonName, _GET["category"] == buttonName and "active" or "", button_names[buttonName]))
            end
        end
        echo("<hr>")
    end
end
?>

<div class="sidebar-container">
    <div>
        <h1>Control Panel</h1>
        <div class="sidebar">
            <?lua
                SetupSidebar({
                    {
                        Name = "Server Settings",
                        Buttons = {
                            "general",
                            "items",
                            "databases",
                            "plugins",
                            "forums",
                            "avatar",
                            "banners",
                            "themes"
                        }
                    },
                    {
                        Name = "System Administration",
                        Buttons = {
                            "email",
                            "taskscheduler",
                            "filesystem",
                            "lua"
                        }
                    },
                    {
                        Name = "Moderation",
                        Buttons = {
                            "logs",
                            "reports",
                            "bans",
                            "emergency"
                        }
                    },
                    {
                        Buttons = {
                            "about"
                        }
                    }
                })
            ?>
        </div>
    </div>

    <div>
        <h1>
            <?lua
                local category = _GET["category"]
                echo(button_names[category])
            ?>
        </h1>
        <?lua if _GET["category"] == "general" then ?>
        <!-- General -->
        <label for="name">Name</label>
        <input type="text" id="name" name="name" size="10" placeholder="Server Emulator" />
        <br>
        <label for="file">Icon</label>
        <input type="file" accept="image/*" name="file"/>
        <?lua elseif _GET["category"] == "items" then ?>
        <?lua elseif _GET["category"] == "forums" then ?>
        <!-- Forums -->
        <?lua
        local fdb = core.GetMasterDatabase()
        local function fesc(s)
            if s == nil then return "" end
            return (tostring(s):gsub("[&<>\"']", {
                ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;",
                ["\""] = "&quot;", ["'"] = "&#39;"
            }))
        end
        local categories = fdb ~= nil and fdb:Query("SELECT Id, Name, SortOrder FROM ForumCategory ORDER BY SortOrder DESC;") or nil

        echo("<h2>Existing forums</h2>")
        if categories == nil or categories[1] == nil then
            echo("<p>No categories yet. Create one below.</p>")
        else
            for _, category in ipairs(categories) do
                echo("<h3>" .. fesc(category.Name) .. "</h3><ul>")
                local forums = fdb:QueryTyped("SELECT Id, Name FROM Forum WHERE CategoryId = ? ORDER BY SortOrder DESC;", category.Id)
                if forums == nil or forums[1] == nil then
                    echo("<li><i>(no forums)</i></li>")
                else
                    for _, f in ipairs(forums) do
                        echo("<li>" .. fesc(f.Name) .. "</li>")
                    end
                end
                echo("</ul>")
            end
        end
        ?>

        <hr>
        <h2>Create category</h2>
        <form action="/v1/forums/create-category" method="post">
            <label for="cat-name">Name</label>
            <input type="text" id="cat-name" name="name" maxlength="100" required />
            <label for="cat-desc">Description</label>
            <input type="text" id="cat-desc" name="description" />
            <label for="cat-sort">Sort order</label>
            <input type="number" id="cat-sort" name="sortOrder" value="0" />
            <button type="submit">Create Category</button>
        </form>

        <hr>
        <h2>Create forum</h2>
        <?lua if categories == nil or categories[1] == nil then ?>
        <p>Create a category first before adding forums.</p>
        <?lua else ?>
        <form action="/v1/forums/create-forum" method="post">
            <label for="forum-name">Name</label>
            <input type="text" id="forum-name" name="name" maxlength="100" required />
            <label for="forum-desc">Description</label>
            <input type="text" id="forum-desc" name="description" />
            <label for="forum-cat">Category</label>
            <select id="forum-cat" name="categoryId" required>
                <?lua
                for _, category in ipairs(categories) do
                    echo(string.format("<option value=\"%d\">%s</option>", category.Id, fesc(category.Name)))
                end
                ?>
            </select>
            <label for="forum-sort">Sort order</label>
            <input type="number" id="forum-sort" name="sortOrder" value="0" />
            <button type="submit">Create Forum</button>
        </form>
        <?lua end ?>
        <?lua elseif _GET["category"] == "about" then ?>
        <!-- About -->
        <p>noobWarrior version: <?lua echo(core.GetVersion()) ?></p>
        <p>HTTP Server Base plugin version: <?lua echo(_G.HTTP_BASE_VER) ?></p>
        <p>Server Emulator frontend plugin version: <?lua echo(_G.EMU_FRONTEND_VER) ?></p>
        <?lua end ?>
    </div>
</div>

<?lua if _GET["category"] == "items" then ?>
<br>
<div class="sidebar">
    <h3>Items</h3>
    <a href="/control-panel?category=items&item=asset">Asset</a>
    <a href="/control-panel?category=items&item=badge">Badge</a>
</div>
<?lua end ?>

<?lua
if _GET["category"] == nil then
    header("Location: /control-panel?category=general")
    http_response_code(302)
end
?>