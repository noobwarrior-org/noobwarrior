<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: HTTP Server Base
-- File: controlpanel.lhp
-- Description:
-- Started by: Hattozo
-- Started on: 6/26/2026
-- ////////////////////////////////////////////////////////////////////////////////
if _SESSION.User == nil then
    include("login-required.lhp")
    return
end

if not has_permission("access.control_panel") then
    http_response_code(403)
    echo("<p>Your rank is not high enough to open the control panel.</p>")
    return
end

local category_permissions = {
    general       = "access.control_panel",
    items         = "items.write",
    databases     = "items.write",
    plugins       = "items.write",
    forums        = "forums.structure",
    avatar        = "items.write",
    banners       = "items.write",
    themes        = "items.write",
    email         = "items.write",
    taskscheduler = "items.write",
    filesystem    = "control_panel.execute",
    lua           = "control_panel.execute",
    logs          = "ban",
    reports       = "ban",
    bans          = "ban",
    emergency     = "control_panel.execute",
    ranks         = "control_panel.ranks",
}

local function may_open(category)
    local permission = category_permissions[category]
    if permission == nil then return true end
    return has_permission(permission)
end

local button_names = {
    ["general"] = "General",
    ["items"] = "Items",
    ["databases"] = "Databases",
    ["plugins"] = "Plugins",
    ["forums"] = "Forums",
    ["avatar"] = "Avatar",
    ["banners"] = "Banners",
    ["themes"] = "Themes",
    ["email"] = "Email",
    ["taskscheduler"] = "Task Scheduler",
    ["filesystem"] = "File System",
    ["lua"] = "Lua Shell",
    ["logs"] = "Logs",
    ["reports"] = "Reports",
    ["bans"] = "Bans",
    ["ranks"] = "Ranks",
    ["emergency"] = "Emergency",
    ["about"] = "About"
}

if cpExtraSections then
    for _, s in ipairs(cpExtraSections) do
        button_names[s.Key] = s.Name
    end
end

local function SetupSidebar(categories)
    for _, category in ipairs(categories) do
        if category.Name then
            echo("<h3>"..category.Name.."</h3>")
        end
        for i, buttonName in ipairs(category.Buttons) do
            if not may_open(buttonName) then
                -- skip: hiding the link is only cosmetic, the body check below is the real gate
            elseif buttonName ~= "emergency" then
                echo(string.format("<a href=\"control-panel?category=%s\" class=\"%s\">%s</a>", buttonName, _GET["category"] == buttonName and "active" or "", button_names[buttonName]))
            else
                echo(string.format("<a href=\"control-panel?category=%s\" class=\"%s\" style=\"color: red;\">%s</a>", buttonName, _GET["category"] == buttonName and "active" or "", button_names[buttonName]))
            end
        end
        echo("<hr>")
    end
end
?>

<div class="sidebar-container">
    <div>
        <h1>Control Panel</h1>
        <div class="sidebar">
            <?lua
                local sidebarCats = {
                    {
                        Name = "Server Settings",
                        Buttons = {
                            "general",
                            "items",
                            "databases",
                            "plugins",
                            "forums",
                            "avatar",
                            "banners",
                            "themes"
                        }
                    },
                    {
                        Name = "System Administration",
                        Buttons = {
                            "email",
                            "taskscheduler",
                            "filesystem",
                            "lua"
                        }
                    },
                    {
                        Name = "Moderation",
                        Buttons = {
                            "logs",
                            "reports",
                            "bans",
                            "ranks",
                            "emergency"
                        }
                    },
                    {
                        Buttons = {
                            "about"
                        }
                    }
                }
                if cpExtraSections then
                    local extraButtons = {}
                    for _, s in ipairs(cpExtraSections) do
                        extraButtons[#extraButtons + 1] = s.Key
                    end
                    table.insert(sidebarCats, #sidebarCats, { Buttons = extraButtons })
                end
                SetupSidebar(sidebarCats)
            ?>
        </div>

        <?lua if _GET["category"] == "items" then ?>
        <div class="sidebar" style="margin-top: 18px;">
            <h3>Items</h3>
            <?lua
                if _GET["item"] == nil then
                    header("Location: /control-panel?category=items&item=Asset")
                    http_response_code(302)
                end
                for _, itemName in ipairs({
                    "Asset", "Badge", "Bundle", "DevProduct", "Group",
                    "Outfit", "Pass", "Set", "Universe", "User"
                }) do
                    echo(string.format('<a href="/control-panel?category=items&item=%s" class="%s">%s</a>',
                        itemName, _GET["item"] == itemName and "active" or "", itemName))
                end
            ?>
        </div>
        <?lua end ?>
    </div>

    <div>
        <h1>
            <?lua
                local category = _GET["category"]
                echo(button_names[category])
            ?>
        </h1>
        <?lua
            if category ~= nil and not may_open(category) then
                http_response_code(403)
                echo("<p>Your rank is not high enough to open this section.</p>")
                return
            end
        ?>
        <?lua if _GET["category"] == "general" then ?>
            <!-- General -->
            <?lua
            local branding = cpBranding
            local gesc = function(v)
                return (tostring(v):gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"):gsub('"',"&quot;"))
            end

            if branding == nil or branding.SaveUrl == nil then
                echo("<p>This server does not expose its branding settings here.</p>")
            else
                local prefix = branding.Prefix or "emu"
                if _GET["err"] then
                    echo('<p style="color: red;">' .. gesc(_GET["err"]) .. "</p>")
                end
                if _GET["msg"] then
                    echo("<p>" .. gesc(_GET["msg"]) .. "</p>")
                end

                local title = reg.GetKeyValue(prefix .. ".branding.title") or ""
                local tagline = reg.GetKeyValue(prefix .. ".branding.tagline") or ""
                local iconSet = tostring(reg.GetKeyValue(prefix .. ".branding.icon") or "") ~= ""

                echo(string.format([[
                    <form action="%s" method="post" enctype="multipart/form-data">
                        <label for="branding-title">Name</label>
                        <input type="text" id="branding-title" name="title" size="40" maxlength="100"
                               placeholder="Server Emulator" value="%s" required>
                        <br>
                        <label for="branding-tagline">Tagline</label>
                        <input type="text" id="branding-tagline" name="tagline" size="40" maxlength="200"
                               placeholder="My noobWarrior server" value="%s">
                        <br>
                        <label for="branding-icon">Icon</label>
                        <img src="%s" alt="" width="64" height="64" style="vertical-align: middle;">
                        <input type="file" id="branding-icon" name="file" accept="image/*">
                        <p>PNG, JPEG, GIF, BMP or WebP, up to 4 MB. A square image looks best.</p>
                        %s
                        <button type="submit">Save</button>
                    </form>
                ]], gesc(branding.SaveUrl), gesc(title), gesc(tagline),
                    gesc(branding.IconUrl or "/emu/icon"),
                    iconSet and [[<label><input type="checkbox" name="removeIcon" value="1"> Remove the current icon</label><br>]] or ""))
            end
            ?>
        <?lua elseif _GET["category"] == "items" then ?>
            <?lua include("items.lhp") ?>
        <?lua elseif _GET["category"] == "forums" then ?>
            <!-- Forums -->
            <link rel="stylesheet" href="/css/forum-admin.css">
            <div id="forum-admin">
            <?lua
            local fdb = core.GetMasterDatabase()
            local function fesc(s)
                if s == nil then return "" end
                return (tostring(s):gsub("[&<>\"']", {
                    ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;",
                    ["\""] = "&quot;", ["'"] = "&#39;"
                }))
            end
            local categories = fdb ~= nil and fdb:Query("SELECT Id, Name, SortOrder FROM ForumCategory ORDER BY SortOrder DESC;") or nil
            
            echo([[
                <details class="fa-create">
                    <summary>+ New category</summary>
                    <form class="fa-ajax fa-create-form" action="/v1/forums/create-category" method="post" data-ok-msg="Category created">
                        <div class="fa-row">
                            <label>Name <input type="text" name="name" maxlength="100" required></label>
                            <label>Description <input type="text" name="description"></label>
                            <label class="fa-sortf">Sort order <input type="number" name="sortOrder" value="0"></label>
                            <button type="submit" class="fa-btn fa-btn-primary">Create category</button>
                        </div>
                    </form>
                </details>
            ]])

            if categories == nil or categories[1] == nil then
                echo([[<p class="fa-empty">No categories yet; create one above to get started.</p>]])
            else
                for _, category in ipairs(categories) do
                    local forums = fdb:QueryTyped("SELECT Id, Name, SortOrder FROM Forum WHERE CategoryId = ? ORDER BY SortOrder DESC;", category.Id)
                    local forumCount = (forums and #forums) or 0

                    echo(string.format([[
                        <div class="fa-cat">
                            <div class="fa-cat-head">
                                <form class="fa-ajax fa-inline" action="/v1/forums/update-category" method="post" data-ok-msg="Category saved">
                                    <input type="hidden" name="categoryId" value="%d">
                                    <input type="text" class="fa-name" name="name" value="%s" maxlength="100" required aria-label="Category name">
                                    <input type="number" class="fa-sort" name="sortOrder" value="%d" title="Sort order" aria-label="Sort order">
                                    <button type="submit" class="fa-btn">Save</button>
                                </form>
                                <form class="fa-ajax fa-inline" action="/v1/forums/delete-category" method="post" data-confirm="Delete the &quot;%s&quot; category?" data-ok-msg="Category deleted">
                                    <input type="hidden" name="categoryId" value="%d">
                                    <button type="submit" class="fa-btn fa-btn-danger"%s>Delete</button>
                                </form>
                            </div>
                            <div class="fa-forums">
                    ]], category.Id, fesc(category.Name), tonumber(category.SortOrder) or 0,
                        fesc(category.Name), category.Id,
                        forumCount > 0 and " disabled title=\"Move or delete its forums first\"" or ""))

                    if forumCount == 0 then
                        echo([[<p class="fa-noforums">No forums in this category yet.</p>]])
                    else
                        for _, f in ipairs(forums) do
                            local threadCount = fdb:QueryTyped("SELECT COUNT(*) AS C FROM ForumThread WHERE ForumId = ?;", f.Id)[1].C
                            echo(string.format([[
                                <div class="fa-forum">
                                    <img class="fa-forum-icon" src="/img/folder.png" alt="">
                                    <form class="fa-ajax fa-inline" action="/v1/forums/update-forum" method="post" data-ok-msg="Forum saved">
                                        <input type="hidden" name="forumId" value="%d">
                                        <input type="text" class="fa-name" name="name" value="%s" maxlength="100" required aria-label="Forum name">
                                        <input type="number" class="fa-sort" name="sortOrder" value="%d" title="Sort order" aria-label="Sort order">
                                        <button type="submit" class="fa-btn">Save</button>
                                    </form>
                                    <form class="fa-ajax fa-inline" action="/v1/forums/delete-forum" method="post" data-confirm="Delete the &quot;%s&quot; forum?" data-ok-msg="Forum deleted">
                                        <input type="hidden" name="forumId" value="%d">
                                        <button type="submit" class="fa-btn fa-btn-danger"%s>Delete</button>
                                    </form>
                                </div>
                            ]], f.Id, fesc(f.Name), tonumber(f.SortOrder) or 0,
                                fesc(f.Name), f.Id,
                                threadCount > 0 and " disabled title=\"Delete or move its threads first\"" or ""))
                        end
                    end

                    echo(string.format([[
                                <details class="fa-addforum">
                                    <summary>+ Add forum</summary>
                                    <form class="fa-ajax fa-create-form" action="/v1/forums/create-forum" method="post" data-ok-msg="Forum created">
                                        <input type="hidden" name="categoryId" value="%d">
                                        <div class="fa-row">
                                            <label>Name <input type="text" name="name" maxlength="100" required></label>
                                            <label>Description <input type="text" name="description"></label>
                                            <label class="fa-sortf">Sort order <input type="number" name="sortOrder" value="0"></label>
                                            <button type="submit" class="fa-btn fa-btn-primary">Create forum</button>
                                        </div>
                                    </form>
                                </details>
                            </div>
                        </div>
                    ]], category.Id))
                end
            end
            ?>
            </div>
            <div id="fa-toasts" class="fa-toasts" aria-live="polite"></div>
            <script src="/js/forum-admin.js"></script>
        <?lua elseif _GET["category"] == "ranks" then ?>
        <!-- Ranks -->
        <?lua
            -- Ranks are numbers 0-255 in the User.Rank column; this page only edits the names an
            -- operator gives those numbers (emu.roles) and the minimum number each action needs
            -- (emu.permissions.*). Assigning a rank to a particular user is done in the SDK's user
            -- item dialog, or by editing User.Rank directly.
            local esc = function(v) return tostring(v):gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"):gsub('"',"&quot;") end
            local roles = reg.GetKeyValue("emu.roles") or {}

            if _GET["err"] then
                echo('<p style="color: red;">' .. esc(_GET["err"]) .. "</p>")
            end
            if _GET["msg"] then
                echo("<p>" .. esc(_GET["msg"]) .. "</p>")
            end

            echo("<p>A rank is a number from 0 to 255. Higher is more privileged. Rank 0 is anyone with no account, including guests, and rank 255 can always do everything - which is what stops a bad edit here from locking you out.</p>")

            echo("<h3>Ranks</h3>")
            echo("<table><tr><th>Number</th><th>Name</th><th></th></tr>")
            for _, role in ipairs(roles) do
                echo(string.format([[<tr>
                    <form action="/v1/ranks/save" method="post">
                    <td><input type="number" name="rank" min="0" max="255" value="%d" style="width: 5em;"></td>
                    <td><input type="text" name="name" value="%s" maxlength="32"></td>
                    <td>
                        <input type="hidden" name="originalRank" value="%d">
                        <button type="submit">Save</button>
                    </form>
                    <form action="/v1/ranks/delete" method="post" style="display: inline;">
                        <input type="hidden" name="rank" value="%d">
                        <button type="submit">Delete</button>
                    </form>
                    </td>
                </tr>]], role.rank or 0, esc(role.name or ""), role.rank or 0, role.rank or 0))
            end
            echo("</table>")

            echo([[<h3>Add a rank</h3>
                <form action="/v1/ranks/save" method="post">
                    <input type="number" name="rank" min="0" max="255" placeholder="50" required style="width: 5em;">
                    <input type="text" name="name" placeholder="Helper" maxlength="32" required>
                    <button type="submit">Add</button>
                </form>]])

            echo("<h3>Permissions</h3>")
            echo("<p>The minimum rank each action requires. An action whose permission is missing is refused to everyone below 255.</p>")
            echo('<table><tr><th>Permission</th><th>Minimum rank</th><th></th></tr>')
            local permissions = reg.GetKeyValue("emu.permissions") or {}
            local function emitPermissions(tbl, prefix)
                local keys = {}
                for k in pairs(tbl) do keys[#keys + 1] = k end
                table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
                for _, k in ipairs(keys) do
                    local v = tbl[k]
                    local name = prefix == "" and tostring(k) or (prefix .. "." .. tostring(k))
                    if type(v) == "table" then
                        emitPermissions(v, name)
                    elseif type(v) == "number" then
                        echo(string.format([[<tr>
                            <form action="/v1/ranks/set-permission" method="post">
                            <td><code>%s</code></td>
                            <td><input type="number" name="rank" min="0" max="255" value="%d" style="width: 5em;"></td>
                            <td><input type="hidden" name="permission" value="%s"><button type="submit">Save</button></td>
                            </form>
                        </tr>]], esc(name), v, esc(name)))
                    end
                end
            end
            emitPermissions(permissions, "")
            echo("</table>")
        ?>
        <?lua elseif _GET["category"] == "about" then ?>
        <!-- About -->
        <p>noobWarrior version: <?lua echo(core.GetVersion()) ?></p>
        <p>HTTP Server Base plugin version: <?lua echo(_G.HTTP_BASE_VER) ?></p>
        <p>Server Emulator frontend plugin version: <?lua echo(_G.EMU_FRONTEND_VER) ?></p>
        <?lua end ?>
        <?lua
        if cpExtraSections then
            for _, s in ipairs(cpExtraSections) do
                if _GET["category"] == s.Key then
                    echo(s.Html)
                end
            end
        end
        ?>
    </div>
</div>

<?lua
if _GET["category"] == nil then
    header("Location: /control-panel?category=general")
    http_response_code(302)
end
?>