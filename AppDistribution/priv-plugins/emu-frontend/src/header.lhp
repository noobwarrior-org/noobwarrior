<?lua
startRenderTime = os.clock()
local function AddNavbarButton(url, name)
   echo(string.format([[<li class="navbar-button"><a href="%s">%s</a></li>]], url, name, name))
end

_SESSION.Token = nil
_SESSION.User = nil

local token = _COOKIE[".LOGINSESSION"]
if token then
    local user = core.ResolveSession(token)
    if user ~= nil then
        _SESSION.Token = token
        _SESSION.User = {
            Id = user.Id,
            Name = user.Name,
            DisplayName = user.DisplayName,
            Rank = user.Rank,
        }
    end
end
?>
<!DOCTYPE html>
<html>
    <head>
        <?lua include("plugin://http-base@noobwarrior.org/src/shared.lhp") ?>
        <link rel="stylesheet" href="/css/emu-main.css">
        <title><?lua echo(pageTitle or "Untitled Page") ?></title>
    </head>
    <body>
        <br>
        <div class="main">
            <div class="header">
                <?lua
                    local brandTitle = tostring(reg.GetKeyValue("emu.branding.title") or "Server Emulator")
                    brandTitle = (brandTitle:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"):gsub('"',"&quot;"))
                    echo(string.format(
                        '<span id="emu-logo"><img src="/emu/icon" alt="%s logo" width="64" height="64"><p>%s</p></span>',
                        brandTitle, brandTitle))
                ?>
                <span id="brand-logo"><img src="/img/icon1024.png" alt="noobWarrior logo" width="64" height="64"><p>noobWarrior</p></span>
            </div>
            <ul class="navbar">
                <div class="navbar-left">
                <?lua
                    AddNavbarButton("/", "Home")
                    AddNavbarButton("/servers", "Servers")
                    AddNavbarButton("/games", "Games")
                    AddNavbarButton("/catalog", "Catalog")
                    AddNavbarButton("/users", "Users")
                    AddNavbarButton("/develop", "Develop")
                    AddNavbarButton("/forums", "Forums")
                    AddNavbarButton("/groups", "Groups")
                    AddNavbarButton("/help", "Help")
                ?>
                </div>
                <div class="navbar-right">
                <?lua
                    if _SESSION.User then
                        AddNavbarButton("/control-panel", "Control Panel")
                        AddNavbarButton("/messages", "Messages")
                        AddNavbarButton("/settings", "Settings")
                        AddNavbarButton(string.format("/users/%d/profile", _SESSION.User.Id), _SESSION.User.DisplayName or _SESSION.User.Name)
                        AddNavbarButton("/v1/logout", "Logout")
                    else
                        AddNavbarButton("/login", "Login")
                    end
                ?>
                </div>
            </ul>
            <div class="content">