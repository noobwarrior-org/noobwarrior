<?lua
startRenderTime = os.clock()
local function AddNavbarButton(url, name)
   echo(string.format([[<li class="navbar-button"><a href="%s">%s</a></li>]], url, name, name))
end
?>
<!DOCTYPE html>
<html>
    <head>
        <?lua include("plugin://http-base@noobwarrior.org/src/shared.lhp") ?>
        <link rel="stylesheet" href="/css/emu-main.css">
        <title><?lua echo(pageTitle or "Untitled Page") ?></title>
    </head>
    <body>
        <br>
        <div class="main">
            <div class="header">
                <span id="emu-logo"><img src="/img/icon1024.png" alt="Server emulator logo" width="64" height="64"><p>Server Emulator</p></span>
                <span id="brand-logo"><img src="/img/icon1024.png" alt="noobWarrior logo" width="64" height="64"><p>noobWarrior</p></span>
            </div>
            <ul class="navbar">
                <div class="navbar-left">
                <?lua
                    AddNavbarButton("/", "Home")
                    AddNavbarButton("/servers", "Servers")
                    AddNavbarButton("/games", "Games")
                    AddNavbarButton("/catalog", "Catalog")
                    AddNavbarButton("/users", "Users")
                    AddNavbarButton("/develop", "Develop")
                    AddNavbarButton("/forums", "Forums")
                    AddNavbarButton("/groups", "Groups")
                    AddNavbarButton("/help", "Help")
                ?>
                </div>
                <div class="navbar-right">
                <?lua
                    if _COOKIE[".LOGINSESSION"] then
                        AddNavbarButton("/control-panel", "Control Panel")
                        AddNavbarButton("/messages", "Messages")
                        AddNavbarButton("/settings", "Settings")
                        AddNavbarButton("/users/86121841/profile", "Hattozo")
                    else
                        AddNavbarButton("/login", "Login")
                    end
                ?>
                </div>
            </ul>
            <div class="content">