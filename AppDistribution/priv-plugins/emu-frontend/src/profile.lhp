<?lua
local id = _PARAMS["userId"]
id = tonumber(id)
if id == nil then
    http_response_code(400)
    die("Invalid id")
end

local db = core.GetEmuDbManager():GetFirstDbWhereItemExists(ItemType.User, id)
if db == nil then
    http_response_code(404)
    die("No user found!")
end
local userRows = db:QueryTyped(
    "SELECT Name, COALESCE(NULLIF(DisplayName, ''), Name) AS DisplayName, Bio, JoinDate " ..
    "FROM User WHERE Id = ?;", id)
if userRows == nil then
    http_response_code(404)
    die("No user found!")
elseif userRows == false then
    http_response_code(500)
    die("Failed to prepare statement")
end
local userRow = userRows[1]
local name = userRow["Name"]
local displayname = userRow["DisplayName"]
local bio = userRow["Bio"]
local joindate = userRow["JoinDate"]

if bio == nil or bio == "" then
    bio = "This user has not set their bio. That's pretty lame."
end
?>

<?lua
pageTitle = name
include("header.lhp")
?>

<style>
table {
    background-color: #454545;
}
table, th, td {
    border: 1px solid #202020;
    border-collapse: collapse;
}
</style>

<table style="width: 420px;">
    <tr>
        <th colspan="2" style="font-size: 16pt;"><?lua echo(displayname) ?>'s Profile</th>
    </tr>
    <tr>
        <th colspan="2">Offline</th>
    </tr>
    <tr>
        <td colspan="2"><img src="" /></td>
    </tr>
    <tr>
        <th colspan="2">Bio</th>
    </tr>
    <tr>
        <td colspan="2" style="text-align: center;"><?lua echo(bio) ?></td>
    </tr>
    <tr>
        <th colspan="2">Information</th>
    </tr>
    <tr>
        <td>Username</td>
        <td>@<?lua echo(name) ?></td>
    </tr>
    <tr>
        <td>Date Joined</td>
        <td>
            <?lua
                local date_string = os.date("%m/%d/%Y %I:%M:%S %p", joindate)
                echo(date_string)
            ?>
        </td>
    </tr>
</table>

<?lua
if _G.MASTERSERVER_FEDERATION ~= nil and _G.MASTERSERVER_FULL_IDENTITY ~= nil then
    local function sesc(s)
        return (tostring(s or ""):gsub("[&<>\"']", {
            ["&"]="&amp;", ["<"]="&lt;", [">"]="&gt;", ["\""]="&quot;", ["'"]="&#39;" }))
    end
    local statuses = _G.MASTERSERVER_FEDERATION.StatusesByAuthor(_G.MASTERSERVER_FULL_IDENTITY(name), 20)
    if statuses ~= nil and #statuses > 0 then
        echo("<h3 style=\"width: 420px;\">Recent statuses</h3>")
        echo("<table style=\"width: 420px;\">")
        for _, s in ipairs(statuses) do
            echo("<tr><td>" .. (sesc(s.Body):gsub("\n", "<br>")) .. "</td></tr>")
        end
        echo("</table>")
    end
end
?>

<?lua include("footer.lhp") ?>