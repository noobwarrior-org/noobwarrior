<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Server Emulator Frontend
-- File: api/forums/delete_category.lhp
-- Description: Deletes an empty forum category (control-panel admin action).
--              Refuses while the category still contains forums.
-- Started by: Hattozo
-- Started on: 6/24/2026
-- ////////////////////////////////////////////////////////////////////////////////
local db = core.GetMasterDatabase()
if db == nil then
    http_response_code(500)
    die("No master database available")
end

local token = _COOKIE[".LOGINSESSION"]
if not token then
    http_response_code(401)
    die("You must be logged in")
end
local userRows = db:QueryTyped(
    "SELECT u.Id AS Id FROM LoginSession s INNER JOIN User u ON u.Id = s.UserId WHERE s.Token = ?;",
    token
)
if not userRows or not userRows[1] then
    http_response_code(401)
    die("You must be logged in")
end

local categoryId = tonumber(_POST["categoryId"])
if categoryId == nil then
    http_response_code(400)
    die("Invalid category")
end

local exists = db:QueryTyped("SELECT 1 FROM ForumCategory WHERE Id = ?;", categoryId)
if not exists or not exists[1] then
    http_response_code(404)
    die("That category does not exist")
end

-- Forum.CategoryId references ForumCategory(Id) with foreign keys enforced, so deleting a
-- non-empty category would fail anyway. Reject it explicitly with a clear message.
local children = db:QueryTyped("SELECT 1 FROM Forum WHERE CategoryId = ? LIMIT 1;", categoryId)
if children and children[1] then
    http_response_code(409)
    die("This category still contains forums. Move or delete them first.")
end

db:QueryTyped("DELETE FROM ForumCategory WHERE Id = ?;", categoryId)
db:MarkDirty()

header("Location: /control-panel?category=forums")
http_response_code(302)
die("")
?>
