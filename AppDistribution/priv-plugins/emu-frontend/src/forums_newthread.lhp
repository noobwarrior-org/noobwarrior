<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Server Emulator Frontend
-- File: forums_newthread.lhp
-- Description: Dedicated page for composing a new forum thread.
-- Started by: Hattozo
-- Started on: 6/24/2026
-- ////////////////////////////////////////////////////////////////////////////////
local db = core.GetMasterDatabase()
local forumId = tonumber(_GET["forum"])

local forum
if forumId ~= nil and db ~= nil then
    local rows = db:QueryTyped("SELECT Id, Name FROM Forum WHERE Id = ?;", forumId)
    if rows and rows[1] then forum = rows[1] end
end

pageTitle = forum and ("New Thread - " .. forum.Name) or "New Thread"
include("header.lhp")
include("forums_common.lhp")
?>

<link rel="stylesheet" href="/css/forums.css">

<?lua
if forum == nil then
    http_response_code(404)
    echo("<p>That forum does not exist.</p>")
elseif _SESSION.User == nil then
    echo("<p>You must <a href=\"/login\">log in</a> to start a thread.</p>")
else
    echo(string.format(
        "<div class=\"forum-crumbs\"><a href=\"/forums\">Forums</a> &raquo; <a href=\"/forums?forum=%d\">%s</a> &raquo; New Thread</div>",
        forum.Id, forumEsc(forum.Name)))
    echo("<h1>New Thread</h1>")
    echo(string.format([[
        <form class="forum-form" action="/v1/forums/create-thread" method="post">
            <input type="hidden" name="forumId" value="%d" />
            <label for="subject"><b>Subject</b></label>
            <input type="text" id="subject" name="subject" maxlength="200" required />
            <label for="content"><b>Message</b></label>
            <textarea id="content" name="content" rows="10" required></textarea>
            <button type="submit">Create Thread</button>
            <a href="/forums?forum=%d">Cancel</a>
        </form>
    ]], forum.Id, forum.Id))
end
?>

<?lua include("footer.lhp") ?>
