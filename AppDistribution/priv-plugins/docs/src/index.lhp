<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Documentation
-- File: index.lhp
-- Description:
-- Started by: Hattozo
-- Started on: 8/3/2026
-- ////////////////////////////////////////////////////////////////////////////////
local vfs = plugin:GetVfs()

local function LoadTable(path)
    local buf = vfs:ReadFile(path)
    if not buf then
        die(string.format("failed to read %s. Contact the owner of this website.", path))
    end
    local func = loadstring(buffer.tostring(buf))
    if not func then
        die(string.format("failed to compile %s. Contact the owner of this website.", path))
    end
    local tbl = func()
    if type(tbl) ~= "table" then
        die(string.format("%s did not return a table. Contact the owner of this website.", path))
    end
    return tbl
end

sections = LoadTable("/texts/sections.luau")
section = nil
local sectionId = _SERVER.LHP_SELF:match("^/([^/]+)")
if sectionId then
    for _, candidate in ipairs(sections) do
        if candidate.Id == sectionId then
            section = candidate
            break
        end
    end
else
    section = sections[1]
end

local index = section and LoadTable("/texts/" .. section.Id .. ".luau") or {}

local function PagePath(file)
    return (file:gsub("%.md$", ""))
end

local function FindPage(children, path)
    for _, child in ipairs(children) do
        if child.File and (path == nil or PagePath(child.File) == path) then
            return child
        end
        local found = child.Children and FindPage(child.Children, path)
        if found then
            return found
        end
    end
end

local requestedPath = _PARAMS.path and _PARAMS.path:gsub("/+$", "")
if requestedPath == "" then
    requestedPath = nil
end

local page = section and FindPage(index, requestedPath)
local pageHtml
local untranslated = false
if page then
    local pageBuf = vfs:ReadFile("/texts/" .. lang.GetCode() .. "/" .. section.Id .. "/" .. page.File)
    if not pageBuf then
        pageBuf = vfs:ReadFile("/texts/en_us/" .. section.Id .. "/" .. page.File)
        untranslated = pageBuf ~= nil and lang.GetCode() ~= "en_us"
    end
    if pageBuf then
        pageHtml = _G.DOCS_MARKDOWN.ToHtml(buffer.tostring(pageBuf))
    end
end
local sectionEmpty = section ~= nil and requestedPath == nil and page == nil
if not pageHtml and not sectionEmpty then
    http_response_code(404)
end

if page then
    pageTitle = lang.Translate("docs.page_title", "{0} - noobWarrior Documentation", lang.Translate(page.Title, page.Fallback))
elseif section then
    pageTitle = lang.Translate("docs.page_title", "{0} - noobWarrior Documentation", lang.Translate(section.Title, section.Fallback))
else
    pageTitle = lang.Translate("docs.title", "noobWarrior Documentation")
end
include("header.lhp")

--[[
local indexStr = ""
local indexHandle = plugin:GetVfs():OpenHandle("/texts/index.lua")
if indexHandle == 0 then
    die("Failed to read file /texts/index.lua")
end
local isReading = true
while isReading do
    isReading, buf = plugin:GetVfs():ReadHandleLine(indexHandle)
    indexStr = indexStr .. buf .. "\n"
end
plugin:GetVfs():CloseHandle(indexHandle)
local func = loadstring(indexStr)
if not func then
    die("failed to compile index.lua. Contact the owner of this website.")
end
local tbl = func()
if type(tbl) ~= "table" then
    die("index.lua did not return a table. Contact the owner of this website.")
end
print(tbl)
]]
?>

<input type="checkbox" id="sidebar-toggle" class="sidebar-toggle">
<label for="sidebar-toggle" class="sidebar-toggle-label"><?lua echo(page and lang.Translate(page.Title, page.Fallback) or lang.Translate("docs.contents", "Contents")) ?></label>
<div class="sidebar">
    <ul class="tree">
    <?lua
    local function PageLink(child)
        return "<a href=\"/"..section.Id.."/"..PagePath(child.File).."\""..(child == page and " selected" or "")..">"..lang.Translate(child.Title, child.Fallback).."</a>"
    end

    local function Iterate(children)
        for _, child in ipairs(children) do
            echo("<li>")
            if child.Children then
                local label = child.File and PageLink(child) or lang.Translate(child.Title, child.Fallback)
                echo("<details open><summary>"..label.."</summary><ul>")
                Iterate(child.Children)
                echo("</ul></details>")
            elseif child.File then
                echo(PageLink(child))
            else
                echo("<span>"..lang.Translate(child.Title, child.Fallback).."</span>")
            end
            echo("</li>")
        end
    end
    Iterate(index)
    ?>
    </ul>
</div>
<div class="divider"></div>
<div class="page markdown">
    <?lua
    if pageHtml then
        if untranslated then
            echo("<p class=\"untranslated\">"..lang.Translate("docs.untranslated", "This page has not been translated into your language yet.").."</p>")
        end
        echo(pageHtml)
    elseif sectionEmpty then
        echo("<h1>"..lang.Translate("docs.section_empty", "Nothing here yet").."</h1><p>"..lang.Translate("docs.section_empty.description", "This section does not have any pages yet.").."</p>")
    else
        echo("<h1>"..lang.Translate("docs.page_not_found", "Page not found").."</h1><p>"..lang.Translate("docs.page_not_found.description", "The page you requested does not exist.").."</p>")
    end
    ?>
</div>

<?lua include("footer.lhp") ?>