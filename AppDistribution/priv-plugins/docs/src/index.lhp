<?lua
-- ////////////////////////////////////////////////////////////////////////////////
-- noobWarrior
-- Plugin: Documentation
-- File: index.lhp
-- Description:
-- Started by: Hattozo
-- Started on: 8/3/2026
-- ////////////////////////////////////////////////////////////////////////////////
local buf = plugin:GetVfs():ReadFile("/texts/index.luau")
local tblStr = buffer.tostring(buf)
local func = loadstring(tblStr)
if not func then
    die("failed to compile index.luau. Contact the owner of this website.")
end
local index = func()
if type(index) ~= "table" then
    die("index.luau did not return a table. Contact the owner of this website.")
end
print(index)

local function FindPage(children, file)
    for _, child in ipairs(children) do
        if child.File and (file == nil or child.File == file) then
            return child
        end
        local found = child.Children and FindPage(child.Children, file)
        if found then
            return found
        end
    end
end

local page = FindPage(index, _GET.page)
local pageHtml
if page then
    local pageBuf = plugin:GetVfs():ReadFile("/texts/" .. page.File)
    if pageBuf then
        pageHtml = _G.DOCS_MARKDOWN.ToHtml(buffer.tostring(pageBuf))
    end
end
if not pageHtml then
    http_response_code(404)
end

pageTitle = page and lang.Translate("docs.page_title", "{0} - noobWarrior Documentation", lang.Translate(page.Title, page.Fallback)) or lang.Translate("docs.title", "noobWarrior Documentation")
include("header.lhp")

--[[
local indexStr = ""
local indexHandle = plugin:GetVfs():OpenHandle("/texts/index.lua")
if indexHandle == 0 then
    die("Failed to read file /texts/index.lua")
end
local isReading = true
while isReading do
    isReading, buf = plugin:GetVfs():ReadHandleLine(indexHandle)
    indexStr = indexStr .. buf .. "\n"
end
plugin:GetVfs():CloseHandle(indexHandle)
local func = loadstring(indexStr)
if not func then
    die("failed to compile index.lua. Contact the owner of this website.")
end
local tbl = func()
if type(tbl) ~= "table" then
    die("index.lua did not return a table. Contact the owner of this website.")
end
print(tbl)
]]
?>

<div class="sidebar">
    <ul class="tree">
    <?lua
    local function Iterate(children)
        for _, child in ipairs(children) do
            echo("<li>")
            if child.Children then
                echo("<details open><summary>"..lang.Translate(child.Title, child.Fallback).."</summary><ul>")
                Iterate(child.Children)
                echo("</ul></details>")
            elseif child.File then
                echo("<a href=\"/?page="..child.File.."\""..(child == page and " selected" or "")..">"..lang.Translate(child.Title, child.Fallback).."</a>")
            else
                echo("<span>"..lang.Translate(child.Title, child.Fallback).."</span>")
            end
            echo("</li>")
        end
    end
    Iterate(index)
    ?>
    </ul>
</div>
<div class="divider"></div>
<div class="page markdown">
    <?lua
    if pageHtml then
        echo(pageHtml)
    else
        echo("<h1>"..lang.Translate("docs.page_not_found", "Page not found").."</h1><p>"..lang.Translate("docs.page_not_found.description", "The page you requested does not exist.").."</p>")
    end
    ?>
</div>

<?lua include("footer.lhp") ?>