<?lua
startRenderTime = os.clock()
local function AddNavbarButton(url, name)
   echo(string.format([[<li class="navbar-button"><a href="%s">%s</a></li>]], url, name, name))
end
?>
<!DOCTYPE html>
<html>
    <head>
        <?lua include("plugin://http-base@noobwarrior.org/src/shared.lhp") ?>
        <!-- <link rel="stylesheet" href="/css/docs.css"> -->
        <title><?lua echo(pageTitle or lang.Translate("docs.title", "noobWarrior Documentation")) ?></title>
    </head>
    <body>
        <!-- <div class="main"> -->
            <div class="header">
                <div id="header-logo">
                    <img src="/img/icon1024.png" alt="<?lua echo(lang.Translate("docs.logo_alt", "Documentation logo")) ?>" width="64" height="64">
                    <p id="logo-text">noobWarrior</p>
                    <p id="docs-text"><?lua echo(lang.Translate("docs.logo_text", "Documentation")) ?></p>
                </div>
            </div>
            <hr>
            <div class="header-links">
                <ul>
                    <?lua
                    for _, entry in ipairs(sections or {}) do
                        echo(string.format([[<li><a href="/%s"%s>%s</a></li>]], entry.Id, entry == section and " selected" or "", lang.Translate(entry.Title, entry.Fallback)))
                    end
                    ?>
                </ul>
            </div>
            <hr>
            <div class="content">