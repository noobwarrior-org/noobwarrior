{
  "name": "noobwarrior",
  "displayName": "noobWarrior",
  "description": "Visual Studio Code support for noobWarrior",
  "icon": "img/icon128.png",
  "version": "0.0.1",
  "publisher": "Hattozo",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "noobwarrior.helloWorld",
        "title": "noobWarrior Hello World"
      }
    ],
    "languages": [{
      "id": "lhp",
      "aliases": ["LHP"],
      "extensions": [".lhp"]
    }],
    "grammars": [
      {
        "language": "lhp",
        "scopeName": "source.lhp",
        "path": "./syntaxes/lhp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.lua": "lua",
          "text.html.basic": "html"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
